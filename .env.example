# Copiá este archivo a .env y completá los valores. El .env nunca se sube (está en .gitignore).

# Claves de API (al menos una). Anthropic: https://platform.claude.com -> Settings -> API Keys
# Es BOT_ANTHROPIC_API_KEY y no ANTHROPIC_API_KEY porque la nube de Claude Code reserva ese nombre
BOT_ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Alpaca, cuenta paper personal: https://app.alpaca.markets -> Paper -> API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = cuenta paper. Con false el bot no arranca salvo que también esté ALPACA_LIVE_CONFIRMADO=si (no se usa en el curso)
ALPACA_PAPER=true
# Feed de velas: iex (tiempo real y gratis), sip (plan pago o más de 15 min atrás) o delayed_sip
ALPACA_FEED=iex

# Proveedor que se prueba primero (anthropic u openai); el otro queda de fallback
PROVEEDOR_PRINCIPAL=anthropic
# Haiku 5.5 por default (medición de la PE2: misma validez que Opus 5.5, 36 veces más barato). Alternativa: claude-opus-5-5
MODELO_ANTHROPIC=claude-haiku-5-5
ESFUERZO_ANTHROPIC=low
MODELO_OPENAI=gpt-6.1-terra

# Presupuesto de tokens (entrada + salida) por ciclo de decisión, reintento incluido
PRESUPUESTO_TOKENS_CICLO=12000

# Dónde se guarda la bitácora (relativo a la raíz del repo)
RUTA_BITACORA=bitacora/bitacora.jsonl
